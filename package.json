{
  "name": "whatsapp-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the WhatsApp Cloud API (Meta) with webhook inbox",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "whatsapp-mcp-server": "dist/index.js" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke": "node scripts/smoke.mjs",
    "clean": "rm -rf dist"
  },
  "engines": { "node": ">=22.13" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
