# --- WhatsApp Cloud API (obrigatórias) ---------------------------------------
# Token permanente de System User (Meta Business Settings > Usuários do sistema),
# com whatsapp_business_messaging e whatsapp_business_management.
WHATSAPP_ACCESS_TOKEN=
# ID do número (Meta app > WhatsApp > API Setup). Não é o número de telefone.
WHATSAPP_PHONE_NUMBER_ID=
# ID da conta WhatsApp Business (WABA). Necessário para as ferramentas de template.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Acesso ao MCP (obrigatória em HTTP) -------------------------------------
# Segredo que protege o endpoint /mcp. Gere com: openssl rand -hex 32
MCP_AUTH_TOKEN=

# --- Webhook (as duas juntas; sem elas o servidor não registra mensagens recebidas)
# Texto livre que você inventa e repete no painel da Meta ao configurar o webhook.
WEBHOOK_VERIFY_TOKEN=
# App Secret do app da Meta (Configurações do app > Básico). Valida a assinatura.
WHATSAPP_APP_SECRET=

# --- Opcionais ---------------------------------------------------------------
# Trava de segurança: se preenchida, só estes números podem receber mensagens.
# Recomendado enquanto estiver testando. Ex.: 5521999998888,5511988887777
WHATSAPP_ALLOWED_RECIPIENTS=
GRAPH_API_VERSION=v26.0
TRANSPORT=http
PORT=3000
DATA_DIR=/data
